<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TbuluAdFree">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- 配置通道不使用 LSPosed 的 xposedsharedprefs / XSharedPreferences：
             真机（LSPosed 2.2.1 / API 102）实测该机制运行期已不向模块暴露
             （de.robv.android.xposed.XSharedPreferences → ClassNotFoundException），
             声明了只会让模块页出现"使用已废弃功能"的警告。
             当前方案（v1.32）：主通道 = 宿主应用本地偏好（两步路内「模块设置」弹窗写入，
             同进程、不经过任何跨进程策略）；辅通道 = 本模块的只读 ContentProvider
             （MIUI 会以自启动名义拦截冷启动，见 Prefs.loadSnapshot 注释）。 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 只读配置桥：向被 Hook 的应用进程提供开关布尔值（settings 偏好文件的只读视图，
             无敏感数据；authority 必须与 Prefs.PROVIDER_AUTHORITY 保持一致）。 -->
        <provider
            android:name=".PrefsProvider"
            android:authorities="com.sumver.tbulu.prefs"
            android:exported="true" />
    </application>

</manifest>
